# Base application
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/outfit_ai_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# PAYMENT_ENV=development displays the MoMo sandbox by default. Never put secrets in FE.
PAYMENT_ENV=development

# VietQR transfer display and verified bank callback adapter. Provision a webhook token
# with the bank feed/aggregator that posts to /api/v1/payments/webhook/vietqr.
BANK_CODE=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
PAYMENT_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token

# MoMo sandbox credentials are issued by MoMo. Configure a public HTTPS IPN URL.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:5173/orders/success
MOMO_IPN_URL=https://your-public-api.example.com/api/v1/payments/webhook/momo
